# Copy to tracker/.env and fill in the backend credentials.

# ---- ingestion target (tvsbackend) ----
# Base URL only; the tracker appends /api/v1/corpus/documents.
BACKEND_URL=http://localhost:5000

# Either a long-lived access token...
BACKEND_TOKEN=

# ...or credentials for a user with a corpus role
# (corpus_uploader | corpus_curator | admin | owner).
# The tracker logs in on first use and re-logs in once on a 401.
BACKEND_EMAIL=
BACKEND_PASSWORD=

# ---- storage cap ----
# Hard ceiling on staged bytes. 1 GiB by default.
DISK_CAP_BYTES=1073741824

# Where PDFs are staged before upload. Deleted after a successful push.
# STAGING_DIR=/home/saurav/Desktop/scarping tvs/tracker/staging

# ---- behaviour ----
# 1 = fill to the cap, push, delete, resume automatically.
# 0 = fill to the cap and stop; use "Push now" in the dashboard.
AUTO_PUSH=1

DOWNLOAD_WORKERS=4
UPLOAD_WORKERS=2
MAX_ATTEMPTS=3

# Times a partition scan is retried (with exponential backoff) before it parks
# as `failed`. Parked partitions block "run complete" until retried.
MAX_SCAN_ATTEMPTS=4

# Skip PDFs the corpus API would reject anyway (its multer limit is 50 MB).
MAX_PDF_BYTES=52428800
MIN_PDF_BYTES=2048

# ---- dashboard ----
API_HOST=127.0.0.1
API_PORT=8787

# ---- S3 (public Open Data buckets; unsigned reads) ----
AWS_REGION=ap-south-1
S3_UNSIGNED=1
HC_BUCKET=indian-high-court-judgments
SC_BUCKET=indian-supreme-court-judgments

# Finite socket timeouts, in seconds. Without these a network stall blocks a
# listing or download indefinitely and pause cannot interrupt it.
S3_CONNECT_TIMEOUT=15
S3_READ_TIMEOUT=60
